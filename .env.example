VITE_FIREBASE_PROJECT_ID="aitutor-7cd89"
VITE_FIREBASE_STORAGE_BUCKET="aitutor-7cd89.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="721584502263"
VITE_FIREBASE_APP_ID="1:721584502263:web:4983868cb606e337e1aaf2"
